ARG BASE_TAG=latest

FROM zephyr-devel:${BASE_TAG}

ARG TARGETARCH

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
	wget \
	libxcb-render-util0 \
	libxcb-shape0 \
	libxcb-icccm4 \
	libxcb-keysyms1 \
	libxcb-image0 \
	libxcb-xkb1 \
	libxkbcommon-x11-0

RUN mkdir -p /etc/udev/rules.d
# Fake udevadm to fool jlink installer.
RUN printf '#!/bin/bash\necho "Fake udevadm called"\n' > /usr/bin/udevadm && chmod +x /usr/bin/udevadm

RUN set -eux; \
	case "${TARGETARCH}" in \
		amd64) JLINK_DEB=JLink_Linux_x86_64.deb ;; \
		arm64) JLINK_DEB=JLink_Linux_arm64.deb ;; \
		*) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
	esac; \
	wget -q "https://www.segger.com/downloads/jlink/${JLINK_DEB}" --post-data "accept_license_agreement=accepted" -O jlink.deb; \
	dpkg --unpack jlink.deb; \
	rm -f /var/lib/dpkg/info/jlink.postinst; \
	apt-get install -f -y; \
	rm jlink.deb

RUN set -eux; \
	case "${TARGETARCH}" in \
		amd64) NRFUTIL_TRIPLE=x86_64-unknown-linux-gnu ;; \
		arm64) NRFUTIL_TRIPLE=aarch64-unknown-linux-gnu ;; \
		*) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
	esac; \
	wget -q "https://files.nordicsemi.com/artifactory/swtools/external/nrfutil/executables/${NRFUTIL_TRIPLE}/nrfutil" -O /usr/local/bin/nrfutil; \
	chmod +x /usr/local/bin/nrfutil

RUN nrfutil install device && \
    mkdir -p /etc/udev/rules.d && \
    nrfutil device --help-install-udev-rules > /etc/udev/rules.d/71-nrfutil.rules

USER user

RUN set -eux; \
	nrfutil install device; \
	if [ "${TARGETARCH}" = "amd64" ]; then \
		nrfutil install device nrf5sdk-tools; \
	else \
		echo "nrf5sdk-tools is not available on ${TARGETARCH}; skipping"; \
	fi
