ARG NCS_REVISION=v2.9.0
ARG WEST_UPDATE_ARGS=""

FROM python:3.12-slim-bookworm AS builder-1

ARG NCS_REVISION
ARG WEST_UPDATE_ARGS
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
USER root

ARG WGET_ARGS="-q --show-progress --progress=bar:force:noscroll"
ENV DEBIAN_FRONTEND=noninteractive
ENV NRFUTIL_HOME=/usr/local/share/nrfutil
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

RUN [ "${TARGETARCH}" = "amd64" ] || { echo "Dockerfile.ncs supports amd64 only (nrfutil toolchain-manager has no Linux ARM64 support)" >&2; exit 1; }

RUN apt-get update && apt-get install -y --no-install-recommends git cmake ninja-build gperf \
  ccache dfu-util device-tree-compiler wget python3-dev python3-venv python3-tk \
  xz-utils file make gcc gcc-multilib g++-multilib libsdl2-dev libmagic1 \
  pkg-config libudev-dev

RUN wget -q https://developer.nordicsemi.com/.pc-tools/nrfutil/x64-linux/nrfutil -O /usr/local/bin/nrfutil && \
    chmod +x /usr/local/bin/nrfutil && \
    nrfutil install toolchain-manager device sdk-manager

ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN uv venv $VIRTUAL_ENV
RUN uv pip install west

FROM builder-1 AS builder-2

RUN west init -m https://github.com/nrfconnect/sdk-nrf --mr ${NCS_REVISION} /opt/ncs-workspace
WORKDIR /opt/ncs-workspace
RUN west update ${WEST_UPDATE_ARGS}
RUN uv pip install -r zephyr/scripts/requirements.txt
RUN uv pip install -r nrf/scripts/requirements.txt
RUN uv pip install -r bootloader/mcuboot/scripts/requirements.txt

RUN nrfutil toolchain-manager install --ncs-version ${NCS_REVISION}
RUN <<ABC
set -e
TOOLCHAIN_DIR=$(find /root/ncs/toolchains -maxdepth 1 -mindepth 1 -type d | head -n 1)
test -n "${TOOLCHAIN_DIR}"
test -d "${TOOLCHAIN_DIR}/opt/zephyr-sdk"
rm -rf /opt/zephyr-sdk
cp -r "${TOOLCHAIN_DIR}/opt/zephyr-sdk" /opt/zephyr-sdk
ABC

FROM builder-1

ARG NCS_REVISION

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
COPY --from=builder-1 /opt/venv /opt/venv
COPY --from=builder-1 /usr/local/bin/nrfutil /usr/local/bin/nrfutil
COPY --from=builder-1 /usr/local/share/nrfutil /usr/local/share/nrfutil
COPY --from=builder-2 /opt/zephyr-sdk /opt/zephyr-sdk
COPY --from=builder-2 /root/ncs/toolchains /opt/ncs/toolchains
ENV PATH="/opt/venv/bin:$PATH"
ENV ZEPHYR_SDK_INSTALL_DIR="/opt/zephyr-sdk"
ENV NCS_TOOLCHAINS_DIR="/opt/ncs/toolchains"
ENV NRFUTIL_HOME="/usr/local/share/nrfutil"
ENV NCS_REVISION="${NCS_REVISION}"

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
	wget \
	libxcb-render-util0 \
	libxcb-shape0 \
	libxcb-icccm4 \
	libxcb-keysyms1 \
	libxcb-image0 \
	libxcb-xkb1 \
	libxkbcommon-x11-0

RUN mkdir -p /etc/udev/rules.d
RUN echo '#!/bin/bash\necho "Fake udevadm called"' > /usr/bin/udevadm && chmod +x /usr/bin/udevadm

RUN wget -q https://www.segger.com/downloads/jlink/JLink_Linux_x86_64.deb --post-data "accept_license_agreement=accepted" -O jlink.deb && \
    dpkg --unpack jlink.deb && \
    rm -f /var/lib/dpkg/info/jlink.postinst && \
    dpkg --configure jlink && \
    apt-get install -f -y && \
    rm jlink.deb

RUN nrfutil install device && \
    mkdir -p /etc/udev/rules.d && \
    nrfutil device --help-install-udev-rules > /etc/udev/rules.d/71-nrfutil.rules

RUN useradd -ms /bin/bash user
USER user

RUN nrfutil install device || true
