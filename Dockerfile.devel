ARG BASE_TAG=latest
ARG ZEPHYR_REVISION=main

FROM zephyr-full-sdk:${BASE_TAG}

ARG ZEPHYR_REVISION
ARG TARGETARCH
USER root

RUN apt-get update && apt-get install -y --no-install-recommends graphviz librsvg2-bin \
	texlive-latex-base texlive-latex-extra latexmk texlive-fonts-recommended imagemagick \
	bluetooth bluez

RUN apt-get install -y coccinelle

# Doxygen, pinned to the version .github/workflows/doc-build.yml uses. The
# Debian package is too old for the commands the Zephyr Doxyfile aliases
# expand to (\qualifier, \important), which makes a local doc build drown in
# warnings that CI never sees.
ARG DOXYGEN_VERSION=1.17.0
ARG DOXYGEN_SHA256SUM=75419ef4f446fc1c24ef12514b574e66e898ee6f527c6ae2ad84f91a905823c2
RUN set -eux; \
	case "${TARGETARCH}" in \
		amd64) \
			cd /tmp; \
			wget -q "https://github.com/doxygen/doxygen/releases/download/Release_${DOXYGEN_VERSION//./_}/doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz"; \
			echo "${DOXYGEN_SHA256SUM}  doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz" | sha256sum -c; \
			tar xf doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz -C /opt; \
			rm doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz ;; \
		arm64) \
			apt-get update && apt-get install -y --no-install-recommends doxygen ;; \
		*) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
	esac

ENV PATH=/opt/doxygen-${DOXYGEN_VERSION}/bin:${PATH}

RUN doxygen --version

# Arm Ecosystem FVPs (amd64 and arm64). Versions are stamped in the filename;
# there is no "latest" permalink. Bump these args to the current release from
# Arm's IoT FVP page.
ARG FVP_CDN=https://developer.arm.com/-/cdn-downloads/permalink/FVPs-Corstone-IoT
ARG FVP_CORSTONE300=FVP_Corstone_SSE-300_11.27_42
ARG FVP_CORSTONE320=FVP_Corstone_SSE-320_11.27_25

RUN set -eux; \
	case "${TARGETARCH}" in \
		amd64) FVP_SUFFIX=Linux64 ;; \
		arm64) FVP_SUFFIX=Linux64_armv8l ;; \
		*) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
	esac; \
	cd /tmp; \
	wget -q -O fvp300.tgz "${FVP_CDN}/Corstone-300/${FVP_CORSTONE300}_${FVP_SUFFIX}.tgz"; \
	tar -xf fvp300.tgz; \
	./FVP_Corstone_SSE-300.sh --i-agree-to-the-contained-eula --no-interactive -q \
		-d /opt/fvp-corstone300; \
	wget -q -O fvp320.tgz "${FVP_CDN}/Corstone-320/${FVP_CORSTONE320}_${FVP_SUFFIX}.tgz"; \
	tar -xf fvp320.tgz; \
	./FVP_Corstone_SSE-320.sh --i-agree-to-the-contained-eula --no-interactive -q \
		-d /opt/fvp-corstone320; \
	ln -s "$(dirname "$(find /opt/fvp-corstone300/models -maxdepth 2 -name 'FVP_Corstone_SSE-300*' -type f | head -n1)")" /opt/fvp-corstone300/models/bin; \
	ln -s "$(dirname "$(find /opt/fvp-corstone320/models -maxdepth 2 -name 'FVP_Corstone_SSE-320*' -type f | head -n1)")" /opt/fvp-corstone320/models/bin; \
	rm -rf /tmp/fvp300.tgz /tmp/fvp320.tgz /tmp/FVP_Corstone_SSE-3*.sh /tmp/license_terms

ENV PATH=/opt/fvp-corstone300/models/bin:/opt/fvp-corstone320/models/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/fvp-corstone300/python/lib:/opt/fvp-corstone320/python/lib

# Verify both models load their bundled libpython at build time (fails the build early if not)
RUN FVP_Corstone_SSE-300_Ethos-U55 --version \
	&& FVP_Corstone_SSE-320 --version

RUN uv pip install -r https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/${ZEPHYR_REVISION}/scripts/requirements.txt
RUN uv pip install -r https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/${ZEPHYR_REVISION}/scripts/requirements-actions.txt

# doc/requirements.txt is the hash-pinned lock CI installs; requirements.in is
# unpinned and drifts from CI (docutils, sphinx). It goes last so nothing
# re-resolves the pinned versions afterwards. reuse is force-reinstalled
# because requirements-base.txt already installed a release reporting the same
# version as the pinned snapshot, so it would otherwise be skipped.
RUN uv pip install -r https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/${ZEPHYR_REVISION}/doc/requirements.txt \
	--require-hashes --reinstall-package reuse

RUN usermod -aG bluetooth user
USER user
